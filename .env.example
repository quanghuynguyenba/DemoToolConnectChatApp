# Telegram Bot token from @BotFather — fill in when ready
TELEGRAM_BOT_TOKEN=

# Neon PostgreSQL — preferred: run `neon deploy` to fill these automatically
# Manual fallback: paste Connection string from https://console.neon.tech
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-xxxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:YOUR_PASSWORD@ep-xxxxx.region.aws.neon.tech/neondb?sslmode=require
NEON_BRANCH=production
NEON_BRANCH_ID=
NEON_FUNCTION_HOST_SUFFIX=

# true = preview recipients without calling Telegram API
DRY_RUN=true

# --- Employee authentication (update_authen_v1.0) ---
# OTP is always emailed; user re-enters the code in Telegram chat.
AUTH_DEV_MODE=false
# HMAC pepper for OTP hashes (change in production; never commit real secrets)
OTP_PEPPER=change-me-in-production
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_RESENDS=5
PHONE_DEFAULT_REGION=VN

# Required: SMTP used to email OTP after employee phone match
# Example (Gmail App Password):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your.sender@gmail.com
# SMTP_PASSWORD=xxxx xxxx xxxx xxxx
# SMTP_FROM=your.sender@gmail.com
# SMTP_USE_TLS=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
